{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "myTravel — дизайн-токены, направление «ABR». Зеркало tokens/tokens.css. Источник правды — CSS; этот файл для Figma Tokens Studio и Tailwind.",
  "$version": "1.0.0",
  "color": {
    "anor": {
      "$description": "Анор (гранат) — бренд и главное действие",
      "100": { "$type": "color", "$value": "#f7e4e4" },
      "200": { "$type": "color", "$value": "#eec1c3" },
      "400": { "$type": "color", "$value": "#d9525c", "$description": "Текст и ссылки в тёмной теме — 4.6:1 на #1b1512" },
      "500": { "$type": "color", "$value": "#c33540" },
      "600": { "$type": "color", "$value": "#a81e2d", "$description": "Базовый. 6.7:1 на каймаке, белый на нём 7.2:1" },
      "700": { "$type": "color", "$value": "#8e1824" },
      "800": { "$type": "color", "$value": "#6b121b" }
    },
    "indigo": {
      "$description": "Бухарское индиго — информация, ссылки, фокус",
      "100": { "$type": "color", "$value": "#e4e6f1" },
      "200": { "$type": "color", "$value": "#c3c8e0" },
      "400": { "$type": "color", "$value": "#5a63a5" },
      "500": { "$type": "color", "$value": "#3a4285" },
      "700": { "$type": "color", "$value": "#22285c", "$description": "Базовый. 12.7:1 на каймаке" },
      "800": { "$type": "color", "$value": "#171c42" }
    },
    "urik": {
      "$description": "Урюк — ожидание и предупреждение. Не более 10% площади экрана",
      "100": { "$type": "color", "$value": "#fbeed9" },
      "200": { "$type": "color", "$value": "#f5d9a8" },
      "500": { "$type": "color", "$value": "#e8a33d", "$description": "Только плашки, точки, иллюстрации — для текста контраст 1.9:1, нельзя" },
      "700": { "$type": "color", "$value": "#8a5e08", "$description": "Текстовый вариант — 5.3:1 на каймаке" }
    },
    "gil": {
      "$description": "Гил (сырцовая глина) — декор, иллюстрации, второй план",
      "100": { "$type": "color", "$value": "#efe4d8" },
      "300": { "$type": "color", "$value": "#dcc9b4" },
      "500": { "$type": "color", "$value": "#c2a183" },
      "700": { "$type": "color", "$value": "#8a6f55" }
    },
    "neutral": {
      "$description": "Тёплая нейтральная шкала: от каймака (50) к туту (900)",
      "50": { "$type": "color", "$value": "#fbf6ee", "$description": "Каймак — основной фон" },
      "100": { "$type": "color", "$value": "#f3ede3" },
      "200": { "$type": "color", "$value": "#e6ded1", "$description": "Границы" },
      "300": { "$type": "color", "$value": "#d3c9b9" },
      "400": { "$type": "color", "$value": "#aea394", "$description": "Только декор и disabled" },
      "500": { "$type": "color", "$value": "#877d70", "$description": "3.8:1 — только текст ≥24px или ≥19px bold" },
      "600": { "$type": "color", "$value": "#665d53", "$description": "6.0:1 — второстепенный текст" },
      "700": { "$type": "color", "$value": "#4a423a" },
      "800": { "$type": "color", "$value": "#342d27" },
      "900": { "$type": "color", "$value": "#2a211c", "$description": "Тут — основной текст, 14.7:1" }
    },
    "semantic": {
      "success": { "$type": "color", "$value": "#1d7a4c" },
      "success-bg": { "$type": "color", "$value": "#dff0e5" },
      "success-fg": { "$type": "color", "$value": "#14532f" },
      "warning": { "$type": "color", "$value": "#e8a33d" },
      "warning-bg": { "$type": "color", "$value": "#fbeed9" },
      "warning-fg": { "$type": "color", "$value": "#8a5e08" },
      "error": { "$type": "color", "$value": "#8e1824" },
      "error-bg": { "$type": "color", "$value": "#f7e4e4" },
      "error-fg": { "$type": "color", "$value": "#6b121b" },
      "info": { "$type": "color", "$value": "#22285c" },
      "info-bg": { "$type": "color", "$value": "#e4e6f1" },
      "info-fg": { "$type": "color", "$value": "#171c42" }
    },
    "status": {
      "$description": "Статусы бронирования. Красный занят брендом, поэтому «отменено» — нейтральный",
      "await": { "$type": "color", "$value": "#8a5e08", "$description": "Ожидание оплаты" },
      "await-bg": { "$type": "color", "$value": "#fbeed9" },
      "await-dot": { "$type": "color", "$value": "#e8a33d" },
      "ok": { "$type": "color", "$value": "#14532f", "$description": "Подтверждено" },
      "ok-bg": { "$type": "color", "$value": "#dff0e5" },
      "ok-dot": { "$type": "color", "$value": "#1d7a4c" },
      "cancel": { "$type": "color", "$value": "#4a423a", "$description": "Отменено" },
      "cancel-bg": { "$type": "color", "$value": "#e6ded1" },
      "cancel-dot": { "$type": "color", "$value": "#877d70" },
      "refund": { "$type": "color", "$value": "#22285c", "$description": "Возврат" },
      "refund-bg": { "$type": "color", "$value": "#e4e6f1" },
      "refund-dot": { "$type": "color", "$value": "#3a4285" }
    }
  },
  "theme": {
    "light": {
      "bg": { "$type": "color", "$value": "{color.neutral.50}" },
      "bg-sunken": { "$type": "color", "$value": "{color.neutral.100}" },
      "surface": { "$type": "color", "$value": "#ffffff" },
      "surface-alt": { "$type": "color", "$value": "{color.neutral.100}" },
      "border": { "$type": "color", "$value": "{color.neutral.200}" },
      "text": { "$type": "color", "$value": "{color.neutral.900}" },
      "text-secondary": { "$type": "color", "$value": "{color.neutral.600}" },
      "accent": { "$type": "color", "$value": "{color.anor.600}" },
      "accent-fg": { "$type": "color", "$value": "#ffffff" },
      "link": { "$type": "color", "$value": "{color.indigo.700}" },
      "focus": { "$type": "color", "$value": "{color.indigo.700}" }
    },
    "dark": {
      "bg": { "$type": "color", "$value": "#1b1512" },
      "bg-sunken": { "$type": "color", "$value": "#150f0d" },
      "surface": { "$type": "color", "$value": "#241c18" },
      "surface-alt": { "$type": "color", "$value": "#2e241f" },
      "border": { "$type": "color", "$value": "#3b302a" },
      "text": { "$type": "color", "$value": "#f3ede3" },
      "text-secondary": { "$type": "color", "$value": "#c2b6a6" },
      "accent": { "$type": "color", "$value": "{color.anor.400}" },
      "accent-fg": { "$type": "color", "$value": "#24100f" },
      "link": { "$type": "color", "$value": "#a8b0e0" },
      "focus": { "$type": "color", "$value": "#a8b0e0" }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": ["Alegreya", "Iowan Old Style", "Palatino Linotype", "Georgia", "Noto Serif", "serif"],
        "$description": "Google Fonts, OFL. Проверено: содержит U+02BB (oʻ, gʻ), Ў, Қ, Ғ, Ҳ, №. Только кегли ≥24px"
      },
      "text": {
        "$type": "fontFamily",
        "$value": ["IBM Plex Sans", "Segoe UI", "Roboto", "Helvetica Neue", "Noto Sans", "Arial", "sans-serif"],
        "$description": "Google Fonts, OFL. Проверено: U+02BB, Ў, Қ, Ғ, Ҳ на месте"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["IBM Plex Mono", "ui-monospace", "SF Mono", "Roboto Mono", "Noto Sans Mono", "monospace"],
        "$description": "Цены, даты, номера рейсов, серии паспортов. Всегда с font-variant-numeric: tabular-nums"
      }
    },
    "rejected": {
      "$description": "Проверены и отклонены: в этих шрифтах нет U+02BB (ʻ) и/или Ғ, ҳ — узбекская латиница и кириллица ломаются",
      "$value": ["Onest", "Manrope", "Rubik", "Golos Text", "PT Sans", "Wix Madefor Text"]
    },
    "weight": {
      "regular": { "$type": "number", "$value": 400 },
      "medium": { "$type": "number", "$value": 500 },
      "semibold": { "$type": "number", "$value": 600 },
      "bold": { "$type": "number", "$value": 700 }
    },
    "scale": {
      "12": { "$type": "dimension", "$value": "0.75rem", "lineHeight": "1rem", "$description": "Мелкие метки, юридические сноски" },
      "14": { "$type": "dimension", "$value": "0.875rem", "lineHeight": "1.25rem", "$description": "Второстепенный текст, подписи полей" },
      "16": { "$type": "dimension", "$value": "1rem", "lineHeight": "1.5rem", "$description": "Основной текст и все поля ввода — меньше нельзя, iOS зумит" },
      "18": { "$type": "dimension", "$value": "1.125rem", "lineHeight": "1.75rem" },
      "24": { "$type": "dimension", "$value": "1.5rem", "lineHeight": "2rem" },
      "32": { "$type": "dimension", "$value": "2rem", "lineHeight": "2.5rem", "letterSpacing": "-0.02em" },
      "48": { "$type": "dimension", "$value": "3rem", "lineHeight": "3.5rem", "letterSpacing": "-0.02em" },
      "64": { "$type": "dimension", "$value": "4rem", "lineHeight": "4.25rem", "letterSpacing": "-0.02em" }
    },
    "tracking": {
      "tight": { "$type": "dimension", "$value": "-0.02em" },
      "normal": { "$type": "dimension", "$value": "0" },
      "wide": { "$type": "dimension", "$value": "0.04em" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.25rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "10": { "$type": "dimension", "$value": "2.5rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" },
    "20": { "$type": "dimension", "$value": "5rem" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px", "$description": "Кнопки, поля, чипы" },
    "md": { "$type": "dimension", "$value": "8px", "$description": "Карточки" },
    "lg": { "$type": "dimension", "$value": "12px", "$description": "Шиты, модалки" },
    "full": { "$type": "dimension", "$value": "999px", "$description": "Только аватары и точки статуса" }
  },
  "shadow": {
    "1": { "$type": "shadow", "$value": "0 1px 2px rgba(42, 33, 28, 0.08)" },
    "2": { "$type": "shadow", "$value": "0 2px 8px rgba(42, 33, 28, 0.10)" },
    "3": { "$type": "shadow", "$value": "0 8px 24px rgba(42, 33, 28, 0.14)" }
  },
  "target": {
    "tap-min": { "$type": "dimension", "$value": "44px", "$description": "Минимальная тап-зона. Между соседними целями — не менее 8px" },
    "focus-width": { "$type": "dimension", "$value": "2px" },
    "focus-offset": { "$type": "dimension", "$value": "2px" }
  },
  "motion": {
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0, 0.2, 1] },
    "duration-fast": { "$type": "duration", "$value": "120ms" },
    "duration": { "$type": "duration", "$value": "200ms" },
    "duration-slow": { "$type": "duration", "$value": "320ms" }
  },
  "signature": {
    "$description": "abr-edge — ступенчатая кромка иката. Плитка 24×8, шаг 3×2. Единственное «смелое» место бренда",
    "abr-height": { "$type": "dimension", "$value": "8px" },
    "abr-tile": { "$type": "dimension", "$value": "24px 8px" },
    "abr-path": { "$type": "string", "$value": "M0 8V6h3V4h3V2h3V0h3v2h3v2h3v2h3v2z" }
  },
  "tailwind": {
    "$description": "Готовый фрагмент для tailwind.config.js — theme.extend",
    "colors": {
      "anor": { "100": "#f7e4e4", "200": "#eec1c3", "400": "#d9525c", "500": "#c33540", "600": "#a81e2d", "700": "#8e1824", "800": "#6b121b" },
      "indigo-mt": { "100": "#e4e6f1", "200": "#c3c8e0", "400": "#5a63a5", "500": "#3a4285", "700": "#22285c", "800": "#171c42" },
      "urik": { "100": "#fbeed9", "200": "#f5d9a8", "500": "#e8a33d", "700": "#8a5e08" },
      "gil": { "100": "#efe4d8", "300": "#dcc9b4", "500": "#c2a183", "700": "#8a6f55" },
      "kaymak": { "50": "#fbf6ee", "100": "#f3ede3", "200": "#e6ded1", "300": "#d3c9b9", "400": "#aea394", "500": "#877d70", "600": "#665d53", "700": "#4a423a", "800": "#342d27", "900": "#2a211c" }
    },
    "fontFamily": {
      "display": ["Alegreya", "Georgia", "serif"],
      "sans": ["IBM Plex Sans", "Noto Sans", "sans-serif"],
      "mono": ["IBM Plex Mono", "monospace"]
    },
    "borderRadius": { "sm": "4px", "DEFAULT": "8px", "lg": "12px" },
    "boxShadow": {
      "1": "0 1px 2px rgba(42, 33, 28, 0.08)",
      "2": "0 2px 8px rgba(42, 33, 28, 0.10)",
      "3": "0 8px 24px rgba(42, 33, 28, 0.14)"
    }
  }
}
